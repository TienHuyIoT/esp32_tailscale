# PC Control Credentials - DO NOT commit this file!
#
# 1. Copy this file to sdkconfig.credentials:
#      cp sdkconfig.credentials.example sdkconfig.credentials
# 2. Edit sdkconfig.credentials with your real values
# 3. Run: idf.py build
#    - First build (no sdkconfig yet): the values below are applied
#      automatically (the example's CMakeLists adds this file to
#      SDKCONFIG_DEFAULTS when it exists).
#    - If sdkconfig already exists: existing values take precedence - delete
#      sdkconfig (it regenerates) or set the values via
#      `idf.py menuconfig` -> Example Configuration.
#
# WiFi credentials are NOT required here when the device is already
# provisioned in NVS (the web UI's "Save & Restart" stores them in the NVS
# partition, which survives normal flashing).

CONFIG_ML_WIFI_SSID="your-wifi-ssid"
CONFIG_ML_WIFI_PASSWORD="your-wifi-password"
CONFIG_ML_TAILSCALE_AUTH_KEY="tskey-auth-XXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# ---------------------------------------------------------------------------
# PC Control API token - generate with:
#   python -c "import secrets; print(secrets.token_hex(24))"
# ---------------------------------------------------------------------------
# Required on every mutating API call (browser UI -> ESP32, X-PC-Token header).
# This is only the first-boot default: a token generated/rotated at runtime
# from /pc/security (login admin/admin by default) is stored in NVS and takes
# precedence over this value.
CONFIG_PCCTL_API_TOKEN=""
